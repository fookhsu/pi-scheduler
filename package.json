{
  "name": "@fookhsu/pi-scheduler",
  "version": "0.1.0",
  "description": "Cron-driven scheduled prompt tasks for Pi, each run in an isolated Task Session",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "scheduler",
    "cron",
    "task-scheduler",
    "automation"
  ],
  "author": "fookhsu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fookhsu/pi-scheduler.git"
  },
  "homepage": "https://github.com/fookhsu/pi-scheduler#readme",
  "bugs": {
    "url": "https://github.com/fookhsu/pi-scheduler/issues"
  },
  "type": "module",
  "bin": {
    "pi-scheduler": "./bin/pi-scheduler.mjs"
  },
  "files": [
    "bin",
    "dist",
    "extensions",
    "skills",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "croner": "^9.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.3.30",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/scheduler.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
